{
 "doctype": "DocType",
 "name": "WhatsApp Conversation",
 "module": "Frappe Whatsapp",
 "engine": "InnoDB",
 "allow_rename": 1,
 "track_changes": 1,
 "field_order": [
  "customer_name",
  "phone_number",
  "status",
  "priority",
  "assigned_to",
  "team",
  "last_message",
  "last_message_at",
  "unread_count",
  "first_response_at",
  "sla_breached",
  "reference_doctype",
  "reference_name",
  "contact",
  "lead",
  "customer",
  "issue",
  "opt_in_status",
  "tags"
 ],
 "fields": [
  {
   "fieldname": "customer_name",
   "fieldtype": "Data",
   "label": "Customer Name",
   "in_list_view": 1
  },
  {
   "fieldname": "phone_number",
   "fieldtype": "Data",
   "label": "Phone Number",
   "reqd": 1,
   "in_list_view": 1,
   "unique": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Open\nPending\nResolved\nClosed",
   "default": "Open",
   "in_list_view": 1
  },
  {
   "fieldname": "priority",
   "fieldtype": "Select",
   "label": "Priority",
   "options": "Low\nMedium\nHigh\nUrgent",
   "default": "Medium"
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "label": "Assigned To",
   "options": "User",
   "in_list_view": 1
  },
  {
   "fieldname": "team",
   "fieldtype": "Link",
   "label": "Team",
   "options": "User Group"
  },
  {
   "fieldname": "last_message",
   "fieldtype": "Small Text",
   "label": "Last Message"
  },
  {
   "fieldname": "last_message_at",
   "fieldtype": "Datetime",
   "label": "Last Message At",
   "in_list_view": 1
  },
  {
   "fieldname": "unread_count",
   "fieldtype": "Int",
   "label": "Unread Count",
   "default": "0"
  },
  {
   "fieldname": "first_response_at",
   "fieldtype": "Datetime",
   "label": "First Response At"
  },
  {
   "fieldname": "sla_breached",
   "fieldtype": "Check",
   "label": "SLA Breached"
  },
  {
   "fieldname": "reference_doctype",
   "fieldtype": "Link",
   "label": "Linked ERP DocType",
   "options": "DocType"
  },
  {
   "fieldname": "reference_name",
   "fieldtype": "Dynamic Link",
   "label": "Linked ERP Document",
   "options": "reference_doctype"
  },
  {
   "fieldname": "contact",
   "fieldtype": "Link",
   "label": "Contact",
   "options": "Contact"
  },
  {
   "fieldname": "lead",
   "fieldtype": "Link",
   "label": "Lead",
   "options": "Lead"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer"
  },
  {
   "fieldname": "issue",
   "fieldtype": "Link",
   "label": "Issue",
   "options": "Issue"
  },
  {
   "fieldname": "opt_in_status",
   "fieldtype": "Select",
   "label": "Opt-in Status",
   "options": "Unknown\nOpted In\nOpted Out",
   "default": "Unknown"
  },
  {
   "fieldname": "tags",
   "fieldtype": "Small Text",
   "label": "Tags"
  },
  {
   "fieldname": "whatsapp_account",
   "fieldtype": "Link",
   "options": "WhatsApp Account",
   "label": "WhatsApp Account",
   "reqd": 1
  },
  {
   "fieldname": "opened_at",
   "fieldtype": "Datetime",
   "label": "Opened At",
   "read_only": 1
  },
  {
   "fieldname": "closed_at",
   "fieldtype": "Datetime",
   "label": "Closed At",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1
  },
  {
   "role": "WhatsApp Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "WhatsApp Agent",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  }
 ],
 "title_field": "customer_name",
 "search_fields": "phone_number,customer_name",
 "sort_field": "last_message_at",
 "sort_order": "DESC"
}
